{
  "manifest_version": 3,
  "name": "皮克敏香菇計時器 (Pikmin Bloom Mushroom Timer)",
  "version": "1.0.0",
  "description": "皮克敏打菇必備神器！戰鬥結束倒數 + 自動 5 分鐘重生提醒鬧鐘，絕不錯過任何一場好菇！",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
